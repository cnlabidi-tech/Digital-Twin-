# Copy to .env and adjust. .env is git-ignored.
# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pipeline_twin
POSTGRES_PORT=5432

# --- Security ---
# secure: MQTT over TLS + credentials + ACL, signed messages, dashboard login
#         (requires: npm run setup -w @twin/security)
# dev:    plain MQTT on localhost, anonymous, no login (debugging only)
SECURITY_MODE=secure

# --- Mosquitto MQTT broker ---
MQTT_PORT=1883     # plain MQTT, dev mode only, bound to localhost
MQTTS_PORT=8883    # MQTT over TLS, secure mode (reachable by the ESP32s)
