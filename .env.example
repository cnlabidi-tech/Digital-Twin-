# Copy to .env and adjust. .env is git-ignored.
# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pipeline_twin
POSTGRES_PORT=5432

# --- Mosquitto MQTT broker ---
# 1883 = plain MQTT (development only, bound to localhost).
# 8883 = MQTT over TLS (enabled in Phase 6).
MQTT_PORT=1883
